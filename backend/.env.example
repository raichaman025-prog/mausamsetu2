# Database (SQLite by default for the prototype; swap for a Postgres DSN in prod)
DATABASE_URL=sqlite:///./mausamsetu.db

# JWT
JWT_SECRET_KEY=mausamsetu-demo-secret-change-in-prod

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Real API integration placeholders (unused by the mock adapters) ---
IMD_API_KEY=
OPENWEATHER_API_KEY=
CWC_RIVER_DATA_API_KEY=
